# Server-only Google Gemini configuration. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=1

# Simple in-memory public-demo guard. Set 0 only for trusted local development.
DELIVERYCHECK_RATE_LIMIT_PER_HOUR=20

# Metadata-only JSONL metrics (no PDFs, images, labels, or filenames).
DELIVERYCHECK_METRICS_LOG=request-metrics.jsonl
