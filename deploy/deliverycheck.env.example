# Server-only DeliveryCheck configuration. Keep this file root-readable only in production.
# Add GEMINI_API_KEY directly on the server; never commit or paste the value into chat.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=1
DELIVERYCHECK_RATE_LIMIT_PER_HOUR=20
DELIVERYCHECK_METRICS_LOG=request-metrics.jsonl
